# Server-only variables. Set these in Vercel > Project Settings > Environment Variables.
MONGODB_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@YOUR_CLUSTER/
MONGODB_DB=family_budget
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set to the canonical production origin, e.g. https://your-budget.vercel.app
AUTH_URL=http://localhost:3000
